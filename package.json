{
  "name": "jev-save",
  "version": "0.1.0",
  "description": "Runtime efficiency guard for coding agents (Claude Code, Codex): Jev judges each tool call for redundancy, necessity and scope before it runs.",
  "type": "module",
  "bin": {
    "jev-save": "src/cli.js"
  },
  "exports": {
    ".": "./src/opencode.js",
    "./server": "./src/opencode.js",
    "./guard": "./src/guard.js",
    "./jev": "./src/jev.js"
  },
  "files": [
    "src",
    "extensions",
    "hooks",
    "plugin.json",
    "gemini-extension.json",
    ".claude-plugin",
    ".codex-plugin",
    ".cursor-plugin",
    ".agents",
    "assets/icon.svg",
    "assets/icon-512.png"
  ],
  "scripts": {
    "test": "node --test test/*.test.js test/*.test.mjs"
  },
  "engines": {
    "node": ">=20.3"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*"
  },
  "peerDependenciesMeta": {
    "@earendil-works/pi-coding-agent": {
      "optional": true
    }
  },
  "pi": {
    "extensions": [
      "./extensions"
    ]
  },
  "keywords": [
    "jev",
    "typesafe",
    "coding-agent",
    "hooks",
    "claude-code",
    "codex",
    "redundant-verification",
    "scope-creep",
    "runtime-guard"
  ],
  "author": "grapefruit0205",
  "contributors": [
    "leepokai (jev-guard)",
    "valentynkit (jev-belay)"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/grapefruit0205/jev-save.git"
  },
  "publishConfig": {
    "access": "public"
  },
  "homepage": "https://github.com/grapefruit0205/jev-save#readme",
  "main": "src/opencode.js",
  "bugs": "https://github.com/grapefruit0205/jev-save/issues"
}
