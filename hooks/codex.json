{
  "description": "jev-save: before each tool call, Jev judges whether it is still necessary, whether it repeats a still-valid result and whether it widens the user's request (plus jev-guard's security questions); results and prompts feed a per-session ledger. Shadow mode by default.",
  "hooks": {
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"${PLUGIN_ROOT}/src/cli.js\" hook --agent codex",
            "timeout": 5,
            "statusMessage": "jev-save: noting prompt"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": ".*",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${PLUGIN_ROOT}/src/cli.js\" hook --agent codex",
            "timeout": 10,
            "statusMessage": "jev-save: judging tool call"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": ".*",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${PLUGIN_ROOT}/src/cli.js\" hook --agent codex",
            "timeout": 10,
            "statusMessage": "jev-save: recording result"
          }
        ]
      }
    ]
  }
}
